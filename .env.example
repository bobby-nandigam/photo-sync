# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Google OAuth (from Google Cloud Console → Credentials) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must EXACTLY match an Authorized redirect URI in the Google console.
# Local dev:
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Where to send the browser after connecting (your frontend origin).
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Token encryption (REQUIRED in production) ---
# Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Sync state storage ---
# Default is a local SQLite file (no server). To use Postgres instead, set
# DATABASE_URL and leave SQLITE_PATH alone, e.g.
#   DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# DATABASE_URL=
SQLITE_PATH=./data/sync_state.db

# --- Router tuning ---
SAFETY_BUFFER_BYTES=536870912   # keep 512 MB free in every account
NEAR_FULL_THRESHOLD=0.90        # warn in the UI past 90% used

# --- Optional AI one-line notes (OFF by default; never blocks sync) ---
AI_NOTES_ENABLED=false
AI_PROVIDER=openai              # openai | gemini
AI_API_KEY=
AI_MODEL=gpt-4o-mini
